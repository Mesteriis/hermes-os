{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "First-party shell permissions; provider host bridges remain isolated to their companion windows.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-owner-vault-provisioning-host-start",
    "allow-owner-vault-provisioning-host-seal",
    "allow-owner-vault-provisioning-host-open-receipt",
    "allow-owner-vault-provisioning-host-cancel",
    "allow-desktop-call-recording-host-connect",
    "allow-desktop-call-recording-host-disconnect"
  ]
}
